  function select(i) {
    [...strand.children].forEach((b, j) => b.setAttribute("aria-selected", String(i === j)));
    const s = stages[i];
    panel.setAttribute("aria-labelledby", "stage-" + i);
    panel.innerHTML = `<div><p class="eyebrow">Stage ${i + 1} of 6</p><h3 style="margin-top:10px">Career ${s.n}</h3><p class="who">${s.who}</p>
      <div class="example"><b>Example</b>${s.ex}</div></div>
      <ul>${s.f.map(x => `<li>${x}</li>`).join("")}</ul>`;
  }
  select(2);

  // Skill discovery demo
  const samples = {
    crew: "Took guest orders on the line during the lunch rush\nCounted the cash drawer at close\nChecked food temperatures and logged them every two hours\nCovered shifts when teammates were out\nTrained two new hires on the grill station",
    ta: "Sourced candidates for 12 open engineering roles\nScheduled interviews with hiring managers\nBuilt a weekly pipeline report in a spreadsheet\nResolved offer-letter issues with candidates",
    intern: "Researched competitor pricing and summarized it\nPresented findings at the team meeting\nWrote the weekly update email for my manager\nUpdated the project dashboard each Friday"
  };
  const rules = [
    [/guest|customer|order|client/i, "Customer service"],
    [/cash|register|drawer|payment/i, "Cash handling and accuracy"],
    [/food|temperature|sanit|safety/i, "Food safety compliance"],
    [/cover|teammate|team|crew/i, "Teamwork and reliability"],
    [/train|new hire|onboard|mentor/i, "Training and onboarding others"],
    [/rush|peak|deadline|fast/i, "Working under pressure"],
    [/log|track|record|every two/i, "Detail-oriented record keeping"],
    [/sourc|candidate|recruit|pipeline/i, "Candidate sourcing"],
    [/schedul|calendar|coordinat/i, "Scheduling and coordination"],
    [/hiring manager|stakeholder|manager/i, "Stakeholder management"],
    [/report|spreadsheet|dashboard|excel|data/i, "Data reporting"],
    [/resolv|issue|problem|fix/i, "Problem solving"],
    [/research|competitor|analy/i, "Research and analysis"],
    [/present|meeting|slides/i, "Presenting to groups"],
    [/wrote|write|email|summar/i, "Written communication"]
  ];
  const ta = document.getElementById("duties"), list = document.getElementById("skills"), tally = document.getElementById("tally");
  let found = [];
  function setSample(key) {
    ta.value = samples[key];
    document.querySelectorAll(".chip").forEach(c => c.setAttribute("aria-pressed", String(c.dataset.sample === key)));
  }
  function discover() {
    const lines = ta.value.split("\n").map(l => l.trim()).filter(Boolean);
    found = [];
    rules.forEach(([re, name]) => {
      const line = lines.find(l => re.test(l));
      if (line && !found.some(f => f.name === name)) found.push({ name, line, state: "inferred" });
    });
    render();
  }
  function esc(s) { return s.replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c])); }
  function render() {
    const c = found.filter(f => f.state === "confirmed").length, r = found.filter(f => f.state === "inferred").length;
    tally.innerHTML = `<span><b>${found.length}</b> skills found</span><span><b>${c}</b> confirmed</span><span><b>${r}</b> to review</span>`;
    if (!found.length) { list.innerHTML = `<li class="empty">No skills spotted yet. Try describing a task with a bit more detail, like who you helped or what you tracked.</li>`; return; }
    list.innerHTML = found.map((f, i) => `
      <li class="skill ${f.state}">
        <span class="name">${esc(f.name)}</span>
        ${f.state === "inferred"
          ? `<span class="acts"><button data-i="${i}" data-a="confirmed">Confirm</button><button data-i="${i}" data-a="dismissed">Not me</button></span>`
          : `<span class="tag ${f.state === "confirmed" ? "t-confirmed" : "t-inferred"}">${f.state === "confirmed" ? "Confirmed" : "Removed"}</span>`}
        <span class="why">${f.state === "inferred" ? '<span class="tag t-inferred" style="margin-right:8px">Inferred</span>' : ""}From: "${esc(f.line)}"</span>
      </li>`).join("");
  }
  list.addEventListener("click", e => {
    const b = e.target.closest("button[data-i]"); if (!b) return;
    found[+b.dataset.i].state = b.dataset.a; render();
  });
  document.querySelectorAll(".chip").forEach(c => c.addEventListener("click", () => { setSample(c.dataset.sample); discover(); }));
  document.getElementById("discover").addEventListener("click", discover);
  setSample("crew"); discover();
  found[0].state = "confirmed"; found[1].state = "confirmed"; render();

  // Early access form (not connected to a backend yet)
  document.getElementById("joinForm").addEventListener("submit", e => {
    e.preventDefault();
    const email = document.getElementById("email"), msg = document.getElementById("joinMsg");
    if (!email.checkValidity() || !email.value) { msg.textContent = "Enter a valid email address, like name@example.com."; email.focus(); return; }
    msg.textContent = "Thanks. Sign-ups aren't connected on this preview yet, so nothing was sent.";
  });
})();
</script>
</body>
