<style>
/* Layout: one continuous "career strand" runs down the page; sections hang off it like entries in a record. */
:root {
  --paper: #F3F7F8;
  --surface: #FFFFFF;
  --ink: #0B2E3C;
  --muted: #536A73;
  --line: #D6E2E5;
  --accent: #10707A;
  --accent-ink: #FFFFFF;
  --accent-soft: #DAEFF0;
  --brand: #5CB9BE;
  --brand-ink: #0B2E3C;
  --win: #A8650F;
  --win-soft: #F7EAD3;
  --sugg: #5B47C2;
  --sugg-soft: #E9E5FA;
  --shadow: 0 1px 2px rgba(11,46,60,.06), 0 12px 32px rgba(11,46,60,.09);
  --f-display: "Bricolage Grotesque", "Avenir Next", "Segoe UI", system-ui, sans-serif;
  --f-body: "IBM Plex Sans", "Helvetica Neue", Arial, system-ui, sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --f-brand: "Saira", "Eurostile", "DIN Alternate", system-ui, sans-serif;
  --wrap: 1120px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #071419; --surface: #0D1E25; --ink: #E2EFF1; --muted: #8FA7AE; --line: #1C3039;
    --accent: #5CC4C9; --accent-ink: #04222A; --accent-soft: #10303A;
    --win: #E8AC52; --win-soft: #33281A; --sugg: #AB9BF6; --sugg-soft: #241F40;
    --shadow: 0 1px 2px rgba(0,0,0,.4), 0 12px 32px rgba(0,0,0,.35);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #071419; --surface: #0D1E25; --ink: #E2EFF1; --muted: #8FA7AE; --line: #1C3039;
  --accent: #5CC4C9; --accent-ink: #04222A; --accent-soft: #10303A;
  --win: #E8AC52; --win-soft: #33281A; --sugg: #AB9BF6; --sugg-soft: #241F40;
  --shadow: 0 1px 2px rgba(0,0,0,.4), 0 12px 32px rgba(0,0,0,.35);
  color-scheme: dark;
}

* { box-sizing: border-box; }
body { background: var(--paper); color: var(--ink); font: 16px/1.6 var(--f-body); -webkit-font-smoothing: antialiased; }
.wrap { max-width: var(--wrap); margin: 0 auto; padding-inline: 20px; }
h1, h2, h3 { font-family: var(--f-display); line-height: 1.05; letter-spacing: -0.02em; margin: 0; text-wrap: balance; }
h2 { font-size: clamp(2rem, 4.2vw, 3rem); font-weight: 700; }
h3 { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; }
p { margin: 0; }
a { color: inherit; }
.eyebrow { font: 500 .75rem/1 var(--f-mono); text-transform: uppercase; letter-spacing: .12em; color: var(--accent); }
.lede { color: var(--muted); font-size: 1.125rem; max-width: 60ch; }
button, input, textarea { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }

.btn { display: inline-flex; align-items: center; gap: .5em; border: 0; border-radius: 999px; padding: .8em 1.4em; font-weight: 600; cursor: pointer; text-decoration: none; transition: transform .15s ease, background .15s ease; }
.btn-primary { background: var(--accent); color: var(--accent-ink); }
.btn-primary:hover { transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
.btn-ghost:hover { box-shadow: inset 0 0 0 1px var(--muted); }

/* Nav */
header.nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
.nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 64px; }
.mark { display: block; color: inherit; }
.mark use { fill: currentColor; }
.wordmark { font: 600 1.15rem/1 var(--f-brand); letter-spacing: .32em; margin-right: -.32em; }
.logo { text-decoration: none; display: flex; align-items: center; gap: 12px; color: var(--ink); }
.logo .mark { width: 34px; height: auto; color: var(--accent); }
.tile { display: inline-grid; place-items: center; background: var(--brand); color: var(--brand-ink); border-radius: 22%; flex: none; }
.tile .mark { width: 72%; height: auto; }
.hero { position: relative; overflow: hidden; }
.hero-mark { position: absolute; right: -6%; top: 50%; translate: 0 -50%; width: min(760px, 70vw); color: var(--accent); opacity: .07; pointer-events: none; }
.hero .wrap { position: relative; }
@media (max-width: 900px) { .hero-mark { display: none; } }
.app-bar { display: flex; align-items: center; justify-content: space-between; }
.app-bar .tile { width: 30px; height: 30px; }
.msg .who { display: flex !important; align-items: center; gap: 8px; }
.msg .who .tile { width: 20px; height: 20px; }
.sheet .brandline { display: flex; align-items: center; gap: 8px; }
.sheet .brandline .tile { width: 22px; height: 22px; }
.nav ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; font-size: .95rem; }
.nav ul a { text-decoration: none; color: var(--muted); }
.nav ul a:hover { color: var(--ink); }
@media (max-width: 860px) { .nav ul { display: none; } }

/* Hero */
.hero { padding-block: 72px 56px; }
.hero .wrap { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
.hero h1 { font-size: clamp(2.6rem, 6.4vw, 5rem); font-weight: 800; letter-spacing: -0.035em; }
.hero h1 em { font-style: normal; color: var(--accent); }
.hero .lede { margin-top: 24px; }
.hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.trust { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 28px; font-size: .875rem; color: var(--muted); }
.trust span { display: inline-flex; align-items: center; gap: 6px; }
.trust span::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
@media (max-width: 900px) { .hero .wrap { grid-template-columns: 1fr; } .hero { padding-block: 48px 40px; } }

/* Phone */
.phone { width: 320px; max-width: 100%; margin-inline: auto; background: var(--surface); border-radius: 40px; padding: 14px; box-shadow: var(--shadow), inset 0 0 0 1px var(--line); }
.screen { border-radius: 28px; background: var(--paper); padding: 22px 18px 18px; display: grid; gap: 14px; }
.screen .hello { font: 700 1.3rem/1.15 var(--f-display); }
.screen .sub { font-size: .85rem; color: var(--muted); }
.ring-row { display: flex; align-items: center; gap: 14px; background: var(--surface); border-radius: 18px; padding: 14px; }
.ring { width: 64px; height: 64px; flex: none; }
.ring-row b { font: 700 1.05rem var(--f-display); display: block; }
.ring-row small { color: var(--muted); font-size: .78rem; line-height: 1.35; display: block; }
.choice { display: flex; align-items: center; gap: 12px; background: var(--surface); border-radius: 16px; padding: 12px 14px; font-size: .9rem; }
.choice i { width: 34px; height: 34px; border-radius: 10px; flex: none; display: grid; place-items: center; font-style: normal; font: 600 .95rem var(--f-mono); }
.choice b { display: block; font-weight: 600; }
.choice small { color: var(--muted); font-size: .78rem; }
.c-win i { background: var(--win-soft); color: var(--win); }
.c-skill i { background: var(--accent-soft); color: var(--accent); }
.c-explore i { background: var(--sugg-soft); color: var(--sugg); }
.streak { display: flex; justify-content: space-between; font: 500 .7rem var(--f-mono); color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
.dots { display: flex; gap: 5px; }
.dots span { width: 9px; height: 9px; border-radius: 3px; background: var(--line); }
.dots span.on { background: var(--accent); }

/* Sections */
section.block { padding-block: 88px; border-top: 1px solid var(--line); }
.head { display: grid; gap: 16px; margin-bottom: 48px; max-width: 760px; }

/* Positioning strip */
.compare { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }
.compare > div { background: var(--surface); padding: 28px; display: grid; gap: 8px; align-content: start; }
.compare .k { font: 500 .72rem var(--f-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
.compare h3 { font-size: 1.15rem; }
.compare p { color: var(--muted); font-size: .95rem; }
@media (max-width: 760px) { .compare { grid-template-columns: 1fr; } }

/* Discovery demo */
.demo { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 24px; display: grid; gap: 16px; align-content: start; min-width: 0; }
.panel label { font-weight: 600; }
.samples { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { border: 1px solid var(--line); background: var(--paper); border-radius: 999px; padding: .35em .9em; font-size: .85rem; cursor: pointer; }
.chip[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
textarea { width: 100%; min-height: 190px; resize: vertical; border: 1px solid var(--line); border-radius: 14px; background: var(--paper); padding: 14px; line-height: 1.55; font-size: .95rem; }
.tally { display: flex; flex-wrap: wrap; gap: 8px 16px; font: 500 .75rem var(--f-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
.tally b { color: var(--ink); }
.skills { display: grid; gap: 10px; list-style: none; margin: 0; padding: 0; }
.skill { border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; align-items: center; animation: rise .35s ease both; }
.skill .name { font-weight: 600; }
.skill .why { grid-column: 1 / -1; font-size: .82rem; color: var(--muted); overflow-wrap: anywhere; }
.skill .acts { display: flex; gap: 6px; }
.skill .acts button { border: 1px solid var(--line); background: var(--paper); border-radius: 8px; padding: .25em .7em; font-size: .8rem; cursor: pointer; }
.skill.confirmed { border-color: var(--accent); }
.skill.dismissed { opacity: .45; }
.empty { color: var(--muted); font-size: .95rem; border: 1px dashed var(--line); border-radius: 14px; padding: 24px; text-align: center; }
@keyframes rise { from { transform: translateY(6px); opacity: .3; } to { transform: none; opacity: 1; } }
@media (max-width: 860px) { .demo { grid-template-columns: 1fr; } }

/* Provenance tags */
.tag { display: inline-flex; align-items: center; gap: 6px; font: 500 .68rem/1 var(--f-mono); text-transform: uppercase; letter-spacing: .08em; padding: .45em .7em; border-radius: 6px; white-space: nowrap; }
.tag::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.t-confirmed { background: var(--accent-soft); color: var(--accent); }
.t-inferred { background: var(--win-soft); color: var(--win); }
.t-suggested { background: var(--sugg-soft); color: var(--sugg); }

/* Vault */
.vault { display: grid; grid-template-columns: .85fr 1.15fr; gap: 48px; align-items: start; }
.vault-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
.vault-list li { display: grid; gap: 4px; padding-left: 18px; border-left: 2px solid var(--line); }
.vault-list b { font-weight: 600; }
.vault-list span { color: var(--muted); font-size: .95rem; }
.record { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; box-shadow: var(--shadow); overflow: hidden; }
.record-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 22px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.record-top b { font: 700 1.05rem var(--f-display); }
.record-top small { color: var(--muted); font-size: .85rem; }
.entry { display: grid; grid-template-columns: 1fr auto; gap: 6px 16px; padding: 16px 22px; border-bottom: 1px solid var(--line); align-items: start; }
.entry:last-child { border-bottom: 0; }
.entry p { font-size: .95rem; min-width: 0; }
.entry small { grid-column: 1; color: var(--muted); font-size: .8rem; }
.rule { margin-top: 24px; padding: 18px 20px; border-radius: 14px; background: var(--accent-soft); color: var(--ink); font-size: .95rem; }
.rule b { color: var(--accent); }
@media (max-width: 900px) { .vault { grid-template-columns: 1fr; } }
@media (max-width: 480px) { .entry { grid-template-columns: 1fr; } .entry small { grid-column: auto; } }

/* Daily */
.daily { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.act { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 28px; display: grid; gap: 12px; align-content: start; }
.act .time { font: 500 .72rem var(--f-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
.act p { color: var(--muted); }
.act .prompt { margin-top: 6px; padding: 12px 14px; border-radius: 12px; background: var(--paper); color: var(--ink); font-size: .92rem; }
.act-win h3 { color: var(--win); }
.act-skill h3 { color: var(--accent); }
.act-explore h3 { color: var(--sugg); }
.principles { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 32px; color: var(--muted); font-size: .95rem; }
.principles b { color: var(--ink); font-weight: 600; }
@media (max-width: 860px) { .daily { grid-template-columns: 1fr; } }

/* Stages */
.strand { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-bottom: 32px; }
.strand::before { content: ""; position: absolute; left: 4%; right: 4%; top: 15px; height: 2px; background: var(--line); }
.stage-btn { position: relative; background: none; border: 0; padding: 0; cursor: pointer; display: grid; justify-items: center; gap: 10px; text-align: center; }
.stage-btn .node { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); border: 2px solid var(--line); font: 500 .75rem var(--f-mono); color: var(--muted); transition: all .2s ease; }
.stage-btn .lbl { font-weight: 600; font-size: .92rem; color: var(--muted); }
.stage-btn[aria-selected="true"] .node { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.stage-btn[aria-selected="true"] .lbl { color: var(--ink); }
.stage-card { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
.stage-card h3 { font-size: 1.8rem; }
.stage-card .who { color: var(--muted); margin-top: 10px; }
.stage-card ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
.stage-card li { display: flex; gap: 10px; font-size: .95rem; }
.stage-card li::before { content: ""; flex: none; width: 6px; height: 6px; margin-top: .65em; border-radius: 50%; background: var(--accent); }
.stage-card .example { margin-top: 20px; padding: 16px; border-radius: 14px; background: var(--paper); font-size: .92rem; }
.stage-card .example b { display: block; font: 500 .7rem var(--f-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 6px; }
.statuses { margin-top: 40px; display: grid; gap: 14px; }
.statuses .row { display: flex; flex-wrap: wrap; gap: 8px; }
.status { border: 1px solid var(--line); border-radius: 999px; padding: .4em 1em; font-size: .88rem; background: var(--surface); }
@media (max-width: 760px) {
  .strand { grid-template-columns: repeat(3, 1fr); row-gap: 20px; }
  .strand::before { display: none; }
  .stage-card { grid-template-columns: 1fr; padding: 24px; }
}

/* Studio */
.studio { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.docs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 28px; }
.doc { border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; background: var(--surface); display: grid; gap: 4px; }
.doc b { font-weight: 600; font-size: .95rem; }
.doc small { color: var(--muted); font: 500 .7rem var(--f-mono); text-transform: uppercase; letter-spacing: .08em; }
.sheet { background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; box-shadow: var(--shadow); padding: 36px 34px; font-size: .86rem; line-height: 1.5; display: grid; gap: 14px; }
.sheet .title { font: 700 1.25rem var(--f-display); }
.sheet .meta { color: var(--muted); font-size: .8rem; }
.sheet h4 { margin: 0; font: 600 .72rem var(--f-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: 6px; }
.sheet ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
.sheet .verify { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; padding-top: 12px; border-top: 1px dashed var(--line); color: var(--muted); font-size: .8rem; }
@media (max-width: 900px) { .studio { grid-template-columns: 1fr; } }
@media (max-width: 420px) { .docs { grid-template-columns: 1fr; } .sheet { padding: 24px 20px; } }

/* Coach */
.coach { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }
.chat { display: grid; gap: 12px; }
.msg { max-width: 88%; padding: 14px 16px; border-radius: 18px; font-size: .95rem; }
.msg.ai { background: var(--surface); border: 1px solid var(--line); border-bottom-left-radius: 6px; }
.msg.me { background: var(--accent); color: var(--accent-ink); justify-self: end; border-bottom-right-radius: 6px; }
.msg .who { display: block; font: 500 .68rem var(--f-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 4px; }
.traits { display: grid; gap: 18px; margin-top: 28px; }
.traits div { display: grid; gap: 2px; }
.traits b { font-weight: 600; }
.traits span { color: var(--muted); font-size: .95rem; }
.fineprint { margin-top: 24px; font-size: .85rem; color: var(--muted); }
@media (max-width: 900px) { .coach { grid-template-columns: 1fr; } }

/* Orgs */
.orgs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.org { border-top: 2px solid var(--ink); padding-top: 20px; display: grid; gap: 10px; align-content: start; }
.org p { color: var(--muted); }
.privacy { margin-top: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }
.privacy > div { background: var(--surface); padding: 28px; display: grid; gap: 14px; align-content: start; }
.privacy ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; font-size: .95rem; }
.privacy li { display: flex; gap: 10px; }
.yes li::before { content: "✓"; color: var(--accent); font-weight: 700; }
.no li::before { content: "✕"; color: var(--win); font-weight: 700; }
@media (max-width: 860px) { .orgs, .privacy { grid-template-columns: 1fr; } }

/* Plans */
.plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.plan { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 28px; display: grid; gap: 16px; align-content: start; }
.plan.featured { border-color: var(--accent); box-shadow: var(--shadow); }
.plan .price { font: 700 1.6rem var(--f-display); }
.plan p { color: var(--muted); font-size: .95rem; }
.plan ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: .93rem; }
.plan li { display: flex; gap: 10px; }
.plan li::before { content: "✓"; color: var(--accent); font-weight: 700; }
@media (max-width: 860px) { .plans { grid-template-columns: 1fr; } }

/* CTA */
.cta { padding-block: 96px; border-top: 1px solid var(--line); }
.cta .box { background: var(--brand); color: var(--brand-ink); border-radius: 28px; padding: clamp(32px, 6vw, 64px); display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; }
.cta .copy { display: grid; gap: 20px; min-width: 0; }
.cta h2 { font-size: clamp(2rem, 5vw, 3.4rem); max-width: 18ch; }
.cta p { color: var(--brand-ink); opacity: .82; max-width: 56ch; }
.lockup { display: flex; align-items: center; gap: clamp(16px, 3vw, 32px); color: var(--brand-ink); }
.lockup .mark { width: clamp(150px, 20vw, 240px); height: auto; }
.lockup .stack { display: grid; font: 500 clamp(2.2rem, 4.6vw, 3.6rem)/1.02 var(--f-brand); text-align: center; }
form.join { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
form.join input { flex: 1 1 240px; min-width: 0; border: 1.5px solid rgba(11,46,60,.35); background: rgba(255,255,255,.35); color: var(--brand-ink); border-radius: 999px; padding: .8em 1.2em; }
form.join input::placeholder { color: rgba(11,46,60,.6); }
form.join select { border: 1.5px solid rgba(11,46,60,.35); background: rgba(255,255,255,.35); color: var(--brand-ink); border-radius: 999px; padding: .8em 1.2em; font: inherit; color-scheme: light; }
.cta .btn-primary { background: var(--brand-ink); color: #FFFFFF; }
.cta :focus-visible { outline-color: var(--brand-ink); }
#joinMsg { font-size: .92rem; min-height: 1.4em; font-weight: 500; }
@media (max-width: 860px) { .cta .box { grid-template-columns: 1fr; } .lockup { order: -1; } .lockup .mark { width: 96px; } .lockup .stack { display: block; letter-spacing: .3em; font-size: 1.6rem; } }

footer { padding-block: 40px 56px; color: var(--muted); font-size: .88rem; }
footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; }
footer .logo { color: var(--muted); }
footer .logo .mark { width: 26px; color: var(--muted); }
footer .wordmark { font-size: .95rem; }

@media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
